generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LinkedInAccount {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobPostings   JobPosting[]
  applications  Application[]
  events        Event[]
  autoApplySchedule AutoApplySchedule?
  notifications Notification[]
  notificationPreference NotificationPreference?

  @@map("linkedin_accounts")
}

model JobPosting {
  id             String   @id @default(cuid())
  linkedInJobId  String
  url            String
  title          String?
  companyName    String?
  location       String?
  workplaceType  String?
  description    String?
  easyApply      Boolean  @default(false)

  discoveredAt   DateTime @default(now())
  lastSeenAt     DateTime @default(now())

  score          Int?
  scoreReason    String?
  scoredAt       DateTime?

  accountId      String
  account        LinkedInAccount @relation(fields: [accountId], references: [id])

  applications   Application[]
  events         Event[]
  notifications  Notification[]

  @@unique([accountId, linkedInJobId])
  @@index([accountId, discoveredAt])
  @@index([accountId, score])
  @@map("job_postings")
}

model Application {
  id            String   @id @default(cuid())
  status        String   @default("queued") // queued|in_progress|needs_review|submitted|failed|blocked
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accountId     String
  account       LinkedInAccount @relation(fields: [accountId], references: [id])

  jobPostingId  String
  jobPosting    JobPosting @relation(fields: [jobPostingId], references: [id])

  steps         ApplicationStep[]
  answers       ApplicationAnswer[]
  events        Event[]
  notifications Notification[]

  @@index([accountId, createdAt])
  @@index([jobPostingId])
  @@map("applications")
}

model ApplicationStep {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())

  applicationId  String
  application    Application @relation(fields: [applicationId], references: [id])

  name           String   // e.g. NAVIGATE_JOB, OPEN_EASY_APPLY, FILL_QUESTION, SUBMIT
  state          String   // e.g. started|succeeded|failed|blocked
  detail         Json?

  @@index([applicationId, createdAt])
  @@map("application_steps")
}

model ApplicationAnswer {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])

  // Best-effort stable identifiers
  questionId    String
  questionLabel String
  required      Boolean @default(false)

  // Draft/edited answer
  answer        String
  confidence    Float   @default(0)
  requiresApproval Boolean @default(true)
  approved      Boolean @default(false)

  source        String  @default("draft") // draft|manual|template

  @@unique([applicationId, questionId])
  @@index([applicationId, approved])
  @@map("application_answers")
}

model AnswerTemplate {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accountId     String?
  // normalized question label fingerprint (lowercased + collapsed whitespace)
  fingerprint   String

  answer        String
  approved      Boolean @default(true)

  @@unique([accountId, fingerprint])
  @@map("answer_templates")
}

model Event {
  id             String   @id @default(cuid())
  time           DateTime @default(now())

  runId          String
  type           String
  payload        Json?

  accountId      String?
  account        LinkedInAccount? @relation(fields: [accountId], references: [id])

  jobPostingId   String?
  jobPosting     JobPosting? @relation(fields: [jobPostingId], references: [id])

  applicationId  String?
  application    Application? @relation(fields: [applicationId], references: [id])

  @@index([runId, time])
  @@map("events")
}

model AutoApplySchedule {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  accountId       String   @unique
  account         LinkedInAccount @relation(fields: [accountId], references: [id])

  enabled         Boolean  @default(false)
  cron            String
  timezone        String   @default("UTC")
  maxAttempts     Int?
  minScore        Int?
  nextRunAt       DateTime
  lastTriggeredAt DateTime?

  @@index([enabled, nextRunAt])
  @@map("auto_apply_schedules")
}

model Notification {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  kind          String
  title         String
  message       String
  metadata      Json?

  accountId     String?
  account       LinkedInAccount? @relation(fields: [accountId], references: [id])

  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])

  jobPostingId  String?
  jobPosting    JobPosting? @relation(fields: [jobPostingId], references: [id])

  readAt        DateTime?
  dismissedAt   DateTime?

  @@index([accountId, createdAt])
  @@index([accountId, readAt, dismissedAt])
  @@map("notifications")
}

model NotificationPreference {
  id                      String   @id @default(cuid())
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  accountId               String   @unique
  account                 LinkedInAccount @relation(fields: [accountId], references: [id])

  notifyLoginRequired     Boolean  @default(true)
  notifyCheckpoint        Boolean  @default(true)
  notifyReadyForReview    Boolean  @default(true)
  notifySubmitted         Boolean  @default(true)
  duplicateCooldownMinutes Int     @default(120)

  @@map("notification_preferences")
}

enum QueueJobStatus {
  queued
  running
  succeeded
  failed
  canceled
}

model QueueJob {
  id           String         @id @default(cuid())
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  type         String
  status       QueueJobStatus @default(queued)
  priority     Int            @default(0)

  // Lease/lock
  leaseOwner   String?
  leasedUntil  DateTime?
  attempts     Int            @default(0)
  maxAttempts  Int            @default(5)

  // Scheduling
  runAfter     DateTime       @default(now())

  payload      Json?
  error        String?

  // Correlation
  runId        String
  accountId    String?
  jobPostingId String?
  applicationId String?

  @@index([status, runAfter, priority])
  @@index([leaseOwner, leasedUntil])
  @@map("queue_jobs")
}
