# Database
DATABASE_URL=postgresql://applyflow:applyflow@localhost:5432/applyflow?schema=public

# AI
OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini

# Logging
LOG_LEVEL=info

# LinkedIn automation
PLAYWRIGHT_USER_DATA_DIR_BASE=.local/linkedin-profiles
LINKEDIN_ACCOUNT_ID=default
HEADFUL=1
MAX_CONCURRENT_PER_ACCOUNT=1
ACCOUNT_COOLDOWN_MS=20000
ACCOUNT_JITTER_PCT=0.2
LINKEDIN_KEYWORDS=software engineer
LINKEDIN_LOCATION=
LINKEDIN_MAX_CARDS=25
LINKEDIN_SYNC_MAX_JOBS=10
RUN_EASY_APPLY_DEMO=0
JOB_POSTING_ID=
EASY_APPLY_MAX_STEPS=20

# Services
PORT=3001
API_BASE_URL=http://localhost:3001
API_KEY=
WEB_API_KEY=

# AI drafts
CANDIDATE_PROFILE_PATH=.local/candidate-profile.json
RUN_AI_DRAFT_DEMO=0
APPLICATION_ID=

# Job scoring
SCORE_THRESHOLD=70
RUN_SCORE_DEMO=0
SCORE_MAX_JOBS=10

# Auto-apply cycle
RUN_AUTO_APPLY_DEMO=0
AUTO_APPLY_TOP_N=5
AUTO_APPLY_MIN_SCORE=70
DAILY_APPLY_LIMIT=10
AUTO_APPLY_SCHEDULE_DEFAULT_CRON=0 */4 * * *
AUTO_APPLY_SCHEDULE_DEFAULT_TIMEZONE=UTC
SCHEDULER_POLL_MS=30000
SCHEDULER_BATCH_SIZE=20
